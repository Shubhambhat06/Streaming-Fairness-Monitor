FROM flink:1.20.3-scala_2.12
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-dev python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --break-system-packages --no-cache-dir apache-flink==1.20.3 || python3 -m pip install --no-cache-dir apache-flink==1.20.3
ENV PYTHONPATH=/opt/project
WORKDIR /opt/project
